PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (password ကို URL-encode လုပ်ပါ — ဥပမာ %40)
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/order_management

# JWT signing secret — 32 စာလုံးကျော် random ဖြစ်ပါ (placeholder မသုံးပါနဲ့ server မစတင်ပါနဲ့)
# ထုတ်လုပ်ရန်: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

# Frontend origins (CORS) — admin panel + user app နှစ်ခုလုံး ခွဲထားလို့ comma နဲ့ သတ်မှတ်ပါ
# local: http://localhost:3000
# production ဥပမာ: https://admin.example.com,https://app.example.com
CLIENT_ORIGIN=http://localhost:3000

# Default master invitation code (admin အတွက် အသုံးပြုသော code)
DEFAULT_INVITATION_CODE=MASTER2024
